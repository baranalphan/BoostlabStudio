# Support contact form — the Hostinger mailbox the form sends through.
# Copy to .env.local for development and add the same values on the live server.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@boostlabgames.com
SMTP_PASS=
# Where messages are delivered (defaults to SMTP_USER).
CONTACT_TO=info@boostlabgames.com
